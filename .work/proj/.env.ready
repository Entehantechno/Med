# MED School — bundled production env.
# On first start the server copies this file to `.env` automatically.
# You do NOT need to rename or edit anything to get the site online.

# Leave blank: on the first start the server generates a strong random secret
# for THIS installation and writes it here. (A secret shipped inside the zip
# would be the same for every site and would let anyone forge admin logins.)
JWT_SECRET=

# Public address of the site (used in e-mails, push links, sitemap, absolute
# URLs). Pre-filled for medschool.ir — change only if you move domains.
APP_URL=https://medschool.ir
NODE_ENV=production

# Virtual-patient AI — optional.
# You can paste the key later in Admin → AI Configuration (recommended)
# OR fill these and restart. Until a key exists, the offline mock engine is used.
AI_PROVIDER=GapGPT
AI_MODEL=gpt-4o-mini
AI_API_KEY=
AI_BASE_URL=https://api.gapgpt.app/v1

# Final VP grades require both valid AI scoring and AI microlearning.
# 0 is an explicit offline diagnostic mode, not recommended for graded exams.
VP_REQUIRE_AI_EVALUATION=1
