# ================================================================
#  MED School — production settings
#
#  HOW TO USE:
#    1. Copy this file to a new file named exactly ".env"
#         (Windows PowerShell:  Copy-Item .env.deploy.example .env )
#    2. Fill in the values below (at minimum, change JWT_SECRET).
#    3. Run:  docker compose -f docker-compose.deploy.yml up -d --build
#
#  Anything left blank keeps a safe default / built-in behaviour.
# ================================================================

# 🔒 REQUIRED — a long random secret that signs login tokens.
#    Generate one (any of these):
#       PowerShell:  [guid]::NewGuid().ToString() + [guid]::NewGuid().ToString()
#       Or online:   just paste 40+ random characters.
JWT_SECRET=change-this-to-a-long-random-string

# 🌐 Your public HTTPS origin (Zarinpal callback + email links).
#    MUST be the live domain. A placeholder (CHANGE-ME / example.com / localhost)
#    is ignored at runtime, but set the real origin so emails and the merchant
#    panel match what students see.
APP_URL=https://medschool.ir

# --- Required for real money: Zarinpal merchant ---
# Without this, production checkout is refused (no free mock Plus).
# In the Zarinpal panel, set the site / callback domain to https://medschool.ir
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=false
# ALLOW_MOCK_PAY=1   # only for a staging box that has no merchant yet

# --- Optional: real AI provider (blank = built-in mock engine) ---
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=

# --- Optional: Google Sign-In for learners ---
# 1) Google Cloud Console → APIs & Services → Credentials → Create OAuth client (Web)
# 2) Authorized JavaScript origins = your exact site origin, e.g. https://medschool.ir
#    (no path). Add http://localhost:PORT for local tests.
# 3) Paste the Client ID below OR save it in Admin → Security (no .env edit needed).
# 4) CSP already allows accounts.google.com / oauth2.googleapis.com.
GOOGLE_CLIENT_ID=

# --- Optional: email verification via SMTP ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=MED School <no-reply@medschool.ir>

# --- Optional: browser push notifications ---
# Generate with:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@medschool.ir
