# MED School server environment (optional)
PORT=4000
JWT_SECRET=change-me-in-production

# --- Optional: Web Push (browser notifications) ---
# Generate keys with:  npx web-push generate-vapid-keys
# If left empty, notifications gracefully fall back to in-app only.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@medschool.local

# --- Optional: Google Sign-In (learners) ---
# Create an OAuth 2.0 Client ID at https://console.cloud.google.com/apis/credentials
# Add your site origin to "Authorized JavaScript origins". Then set:
GOOGLE_CLIENT_ID=

# --- Optional: Email verification (SMTP) ---
# If left empty, email signup auto-verifies (fine for local/dev).
APP_URL=http://localhost:4000

# --- Payments: Zarinpal gateway (premium subscriptions) ---
# Leave ZARINPAL_MERCHANT_ID empty to use the built-in MOCK gateway (no real money),
# which is perfect for local testing. To accept real payments, set your merchant id
# from https://www.zarinpal.com and set APP_URL to your public https domain.
ZARINPAL_MERCHANT_ID=
# Set to "true" while testing with Zarinpal's sandbox; "false" (or empty) for production.
ZARINPAL_SANDBOX=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=MED School <no-reply@yourdomain.com>
